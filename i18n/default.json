  "consent.installed-none": "none",  // PM_TEXT_AI
  "consent.intro": "These mods change Phasmophobia in ways Kinetic Games does not support. Read this before you agree.",  // PM_TEXT_AI
  "consent.programs": "<b>Mods are programs.</b> A mod runs its own code on your computer, with your permissions, and can do anything a program can. Only install community mods from authors you trust, and only when their source code is publicly available.",
