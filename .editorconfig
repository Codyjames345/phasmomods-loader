# PhasmoMods Loader editor settings, measured from the code as it is. tools/style_check.ps1 enforces the
# whitespace rules here over the tracked files during validate.ps1; see CONTRIBUTING.md.
root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
insert_final_newline = true
trim_trailing_whitespace = true

# .gitattributes keeps batch scripts with CRLF on disk.
[*.{bat,cmd}]
end_of_line = crlf

# Two trailing spaces are Markdown's line break.
[*.md]
trim_trailing_whitespace = false

[*.{c,cc,cpp,h,hpp}]
indent_size = 2

[*.{json,yml,yaml}]
indent_size = 2

[*.ps1]
indent_size = 4

[{CMakeLists.txt,*.cmake}]
indent_size = 2

[Makefile]
indent_style = tab
