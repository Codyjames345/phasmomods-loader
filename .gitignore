# Build output, regenerated by build.ps1 and package.ps1. Anchored to the root, because
# third_party/minhook/build holds upstream project files rather than output.
/build/
/dist/

# Working space for one checkout: harness ledger, agent session logs and reviews.
/.harness/
/.integration/
/.superpowers/

# Reverse-engineering working files, kept out because they are derived from the game's own
# binaries: the Ghidra project, decompiled output, the import log, the RVA name table that
# re/names.mjs builds from a Cpp2IL DiffableCs dump, and what tools/gamecheck.ps1 writes (the
# copied game files and their dump, and every map entry's address in that build).
/re/ghidra/
/re/out/
/re/names.tsv
/re/import.log
/re/dump/
/re/map-addresses.tsv

/.vscode