// Custom Ghosts' player-facing text: each ghost's journal page and ability (the author's own), and the HUD lines of a player
// controlling one.
// Each text marked PM_TEXT_AI was written by AI, before the AI policy (AI_POLICY.md) or as a draft the author asked
// for; the author replaces it and takes the mark off; one marked PM_TEXT_TODO is a placeholder waiting for the
// author's words. A {{token}} is a value the code fills in. Keep one entry per line.
{
  "ghost.asterion.description": "The Minotaur of the labyrinth, by its own name. A battering brute that makes a maze of any house, doors only slow it, and it never closes one.",
  "ghost.asterion.name": "Asterion",
  "ghost.asterion.strength": "A closed door never stops an Asterion for good: it batters it down, and the door stays broken open.",
  "ghost.asterion.weakness": "Battering a door down takes an Asterion a few seconds, and it can be heard far away.",
  "ghost.black_shuck.description": "The phantom hound of the East Anglian roads, blind but never lost. It cannot see or hear you; it follows your scent, step for step, until salt, running water or rain breaks it.",
  "ghost.black_shuck.name": "Black Shuck",
  "ghost.black_shuck.strength": "In a hunt a Black Shuck follows the exact path its prey walked, round every corner and into hiding places, though it cannot see or hear.",
  "ghost.black_shuck.weakness": "Salt, running water or rain breaks a Black Shuck's scent, and it loses anyone on the other side.",
  "ghost.bogeyman.description": "The thing in the closet, which knows every place a frightened child hides. It lurks there, hunts only the youngest player, and starts each hunt from the closet nearest them.",
  "ghost.bogeyman.name": "Bogeyman",
  "ghost.bogeyman.strength": "A Bogeyman's hunts begin from the closet or locker nearest the youngest player, and they go only for that player until they reach the truck or die.",
  "ghost.bogeyman.weakness": "A Bogeyman is slow in open rooms and loses sight of its prey there sooner, and while it hunts the youngest player it ignores everyone else.",
  "ghost.brownie.description": "The Scottish house spirit that works only while nobody is watching. Unseen it is quick and silent in a hunt; watched, it slows to a walk, and outside a hunt it does nothing in view.",
  "ghost.brownie.name": "Brownie",
  "ghost.brownie.strength": "A Brownie is very fast in a hunt while nobody looks at it, and then its footsteps make no sound, even to equipment.",
  "ghost.brownie.weakness": "A Brownie slows to less than a walk while anyone looks at it, and then its footsteps can be heard, if only up close.",
  "ghost.draugr.description": "The restless dead of the Norse barrows, jealous guardians of their resting place and all that lies in it. It keeps to its room, and whatever is taken from there, it wants back from the thief alone.",
  "ghost.draugr.name": "Draugr",
  "ghost.draugr.strength": "Carry anything out of a Draugr's room and it may hunt while your sanity is still high, going only for the thief until they reach the truck or die.",
  "ghost.draugr.weakness": "A Draugr takes back what was taken, and its room turns colder until it does. In a hunt it ignores all but the thief and slows far from its room.",
  "ghost.dullahan.description": "The headless rider of Irish legend, which charges down whatever lies straight ahead. Its mount cannot turn, so in the house it is fast on a long run and all but stops at a corner.",
  "ghost.dullahan.name": "Dullahan",
  "ghost.dullahan.strength": "A Dullahan is very fast on long, straight runs.",
  "ghost.dullahan.weakness": "A Dullahan turns slowly and loses most of its speed at every corner.",
  "ghost.echo.ability": "Speak",
  "ghost.echo.about": "Call out with the last words a player said, in their own voice.",
  "ghost.echo.description": "The nymph of Greek myth, cursed to repeat only what others say. A lonely mimic, it stays quiet unless someone speaks near it, then answers in their voice.",
  "ghost.echo.name": "Echo",
  "ghost.echo.strength": "An Echo can call out in the voice of anyone it has heard, and it repeats what players do in its room: the switch or door you just used is the next thing it touches.",
  "ghost.echo.weakness": "With nobody speaking near it for a while, an Echo falls quiet and rarely acts.",
  "ghost.gremlin.ability": "Short out",
  "ghost.gremlin.about": "Switch off the nearest placed equipment that nobody is holding or standing beside.",
  "ghost.gremlin.description": "The saboteur airmen blamed for every failing engine in the Second World War. It cannot leave a running machine alone, unless someone is standing by it.",
  "ghost.gremlin.name": "Gremlin",
  "ghost.gremlin.strength": "A Gremlin switches off equipment that has been set down and left running.",
  "ghost.gremlin.weakness": "A Gremlin will not touch equipment someone is holding or standing beside.",
  "ghost.hydra.description": "The many-headed serpent of Lerna: cut off one head and two grow back. Its flame burns green as marsh fire, and every smudge grows it another head.",
  "ghost.hydra.name": "Hydra",
  "ghost.hydra.strength": "Smudge a Hydra in a hunt and it splits into apparitions, only one of them real; smudge it again and there are more.",
  "ghost.hydra.weakness": "A Hydra's false heads are harmless and make no sound as they walk.",
  "ghost.kikimora.ability": "Tidy away",
  "ghost.kikimora.about": "Carry off the nearest equipment lying in a dark room and hide it in another dark, empty room.",
  "ghost.kikimora.description": "The Slavic household spirit behind the stove, fussy about other people's mess. It tidies away whatever the living leave lying around in the dark, somewhere they will not think to look.",
  "ghost.kikimora.name": "Kikimora",
  "ghost.kikimora.strength": "A Kikimora carries off equipment left on the floor and hides it in another room.",
  "ghost.kikimora.weakness": "A Kikimora will not touch anything in a room with the lights on.",
  "ghost.knell.description": "The slow toll of a funeral bell, on a beat that never changes. Relentless in a hunt, it surges and crawls on a two-second beat you can hear in its steps.",
  "ghost.knell.name": "Knell",
  "ghost.knell.strength": "In a hunt a Knell surges to great speed on every other beat.",
  "ghost.knell.weakness": "Between surges a Knell crawls at about a third of the base speed; run on its slow beat.",
  "ghost.lethe.description": "Named for the river of forgetting in the underworld. It has forgotten who it was and makes the living forget too: photos fade, and in a hunt it loses you a second after you leave its sight.",
  "ghost.lethe.name": "Lethe",
  "ghost.lethe.strength": "Photos, videos and recordings of a Lethe fade from the journal a few minutes after they are taken, unless someone looks at them first.",
  "ghost.lethe.weakness": "A Lethe forgets its prey: once it loses sight of someone in a hunt, it gives up the chase within a second.",
  "ghost.lithobolia.ability": "Throw",
  "ghost.lithobolia.about": "Throw the nearest loose object at a player in sight.",
  "ghost.lithobolia.description": "Named for the stone-throwing devil that pelted a New Hampshire house in 1682. A spiteful thrower that wants a target, it throws only at players it can see, never at an empty room.",
  "ghost.lithobolia.name": "Lithobolia",
  "ghost.lithobolia.strength": "A Lithobolia throws only at players it can see, and a hit costs more than a fright.",
  "ghost.lithobolia.weakness": "With nobody in sight a Lithobolia throws nothing at all.",
  "ghost.mesmer.description": "Named for the showman whose audiences saw whatever he wished. An illusionist with a different face for everyone, no two players agree on what a Mesmer showed them.",
  "ghost.mesmer.name": "Mesmer",
  "ghost.mesmer.strength": "Each player sees a Mesmer differently, and the truck's sanity monitor shows the team saner than they are.",
  "ghost.mesmer.weakness": "A Mesmer cannot fool a camera: video, photos and the D.O.T.S. projector show it as it is.",
  "ghost.squatter.description": "Not a ghost at all, but a person living in the house, wearing a bedsheet and pretending to be one. It wants you off its property, and it says so, loudly.",  // PM_TEXT_AI
  "ghost.squatter.name": "Squatter",
  "ghost.squatter.strength": "Once it has seen you, a Squatter chases at just under a sprint, and it does not stop until everyone is out of the house. Then it locks the door behind you.",  // PM_TEXT_AI
  "ghost.squatter.weakness": "A Squatter is clumsy and trips over what lies in its way. It cannot open a closed hiding place, and soon gives up kicking at one.",  // PM_TEXT_AI
  "ghost.tempest.description": "A storm spirit of the old weather lore. It moves with the lightning, and the wilder the night, the more often it strikes.",
  "ghost.tempest.name": "Tempest",
  "ghost.tempest.strength": "In a hunt a Tempest cannot be seen, except when lightning strikes; then it is very fast.",
  "ghost.tempest.weakness": "Between strikes a Tempest is slow, and the clearer the night, the rarer its lightning.",
  "hud.draugr-angered": "<color=#E04030>Something has left your room</color>: you may hunt from 65% sanity",  // PM_TEXT_AI
  "hud.draugr-whole": "Your room is whole",  // PM_TEXT_AI
  "hud.dullahan-charge": "Charge: {{speed}}% speed",  // PM_TEXT_AI
  "hud.echo-dormant": "Silence: no voice near you; you are dormant and most of what you try is lost",  // PM_TEXT_AI
  "hud.echo-hearing": "Voices: you hear the living near you",  // PM_TEXT_AI
  "hud.kikimora-lit": "The lights are on here: you cannot touch anything"  // PM_TEXT_AI
}
